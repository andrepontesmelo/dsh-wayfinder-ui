{
  "name": "dsh-wayfinder-ui",
  "version": "0.1.0",
  "description": "DSH web-profile plugin: spawns one top-level session per ready wayfinder task (wayfinder_spawn_session), prints the spawn protocol (wayfinder_snippet), and triggers an in-session Wayfinder map card above the composer (wayfinder_mock_map), rendered from a session projection like the To-dos panel.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "wayfinder",
    "dsh-plugin"
  ],
  "license": "MIT",
  "author": "Andre Melo",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrepontesmelo/dsh-wayfinder-ui.git"
  },
  "bugs": {
    "url": "https://github.com/andrepontesmelo/dsh-wayfinder-ui/issues"
  },
  "homepage": "https://github.com/andrepontesmelo/dsh-wayfinder-ui#readme",
  "engines": {
    "node": ">=22"
  }
}